<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <!-- Solar Core Radial Gradient -->
    <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="25%" stop-color="#ffe066"/>
      <stop offset="60%" stop-color="#ff9d00"/>
      <stop offset="85%" stop-color="#ff4d00"/>
      <stop offset="100%" stop-color="#ff1a53"/>
    </radialGradient>
    
    <!-- Outer Corona Flare Gradient -->
    <linearGradient id="flareGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#ff9d00" stop-opacity="0.8"/>
      <stop offset="50%" stop-color="#ff3366" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#00d2ff" stop-opacity="1"/>
    </linearGradient>

    <!-- Deep Space Background Gradient -->
    <radialGradient id="spaceBg" cx="50%" cy="50%" r="50%">
      <stop offset="70%" stop-color="#07090e"/>
      <stop offset="100%" stop-color="#0f1523"/>
    </radialGradient>

    <!-- Glow Filter -->
    <filter id="coronaBlur" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="2.5" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Circular Outer Container -->
  <circle cx="32" cy="32" r="31" fill="url(#spaceBg)" stroke="rgba(255, 157, 0, 0.3)" stroke-width="1.5"/>

  <!-- Corona Aura Rings -->
  <circle cx="32" cy="32" r="26" fill="none" stroke="#ff9d00" stroke-width="1" stroke-dasharray="2 3" opacity="0.6"/>
  <circle cx="32" cy="32" r="22" fill="#ff6b35" opacity="0.15" filter="url(#coronaBlur)"/>

  <!-- Magnetic Loop Arcs (Coronal Loops) -->
  <path d="M 20 22 C 24 12, 38 12, 42 20" fill="none" stroke="url(#flareGrad)" stroke-width="2" stroke-linecap="round"/>
  <path d="M 16 34 C 10 26, 20 16, 28 20" fill="none" stroke="#ff9d00" stroke-width="1.5" stroke-linecap="round" opacity="0.8"/>
  <path d="M 38 42 C 48 46, 52 34, 46 26" fill="none" stroke="#ff3366" stroke-width="1.8" stroke-linecap="round"/>

  <!-- Eruptive Solar Flare Jet (Major M/X Flare Eruption) -->
  <path d="M 40 22 Q 52 10, 60 4 Q 50 14, 43 25 Z" fill="url(#flareGrad)" filter="url(#coronaBlur)"/>
  <circle cx="59" cy="5" r="2" fill="#00d2ff"/>

  <!-- Main Solar Disk -->
  <circle cx="32" cy="32" r="16" fill="url(#sunGlow)"/>

  <!-- Sunspot Active Regions (Magnetic Bipolar Pairs) -->
  <ellipse cx="27" cy="30" rx="2.5" ry="1.8" fill="#590014" opacity="0.85"/>
  <ellipse cx="34" cy="33" rx="3.2" ry="2.2" fill="#40000a" opacity="0.9"/>
  <circle cx="37" cy="27" r="1.5" fill="#4a0010" opacity="0.8"/>
</svg>
